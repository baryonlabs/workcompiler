{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenWorkCompiler Ingress Protocol Schema",
  "type": "object",
  "required": [
    "event_id",
    "type",
    "source",
    "timestamp",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "description": "Event type e.g., message.received, webhook.payload, cron.trigger, email.received"
    },
    "source": {
      "type": "string",
      "description": "Event origin channel e.g., slack, teams, cron, webhook, email"
    },
    "actor": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object"
    },
    "correlation": {
      "type": "object",
      "properties": {
        "trace_id": {
          "type": "string"
        },
        "workflow_id": {
          "type": "string"
        },
        "user_id": {
          "type": "string"
        }
      }
    }
  }
}