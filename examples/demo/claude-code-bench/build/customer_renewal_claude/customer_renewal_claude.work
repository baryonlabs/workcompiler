# HOW — OpenWorkLang source generated by the OpenWorkCompiler build emitter from session claude_5603ea11-cf34-4d8d-b6db-0be21322061e.
# WHAT lives in the task/behavior contracts; this file decides how each action executes and where
# an agent must stay in the loop. Edit and recompile:  python3 -m core.openworklang compile build/customer_renewal_claude/customer_renewal_claude.work
#
# executors: code = replay deterministic handler (0 tokens) · rule = RuleExecutor · ml/slm = trained model once
#            promoted (fallback: llm) · llm = frontier model (prompts/<action>.prompt.md) · human = review gate
# escalation: agent = the step's output was synthesized by the agent; must be regenerated when params change
#   customer_id: recorded value CUST-1001; bound from the request at run time (see PARAMS.json)
#   contract_id: recorded value CTR-2024-0917; bound from the request at run time (see PARAMS.json)

work customer_renewal_claude {
  goal: "Compiled workflow for automating customer renewal claude"

  params:
    - customer_id
    - contract_id

  inputs:
    - content
    - file_path
    - cmd

  outputs:
    - content
    - tool_calls
    - role
    - response_id
    - status
    - stop_reason
    - cache_creation_tokens

  invariants:
    - use_current_pricing_policy
    - verify_current_contract

  workflow:
    - read_task
    - read_contracts
    - read_behavior
    - shell_cd
    - shell_mkdir
    - shell_cat
    - respond

  executors: {
    read_task: code,
    read_contracts: code,
    read_behavior: code,
    shell_cd: code,
    shell_mkdir: code,
    shell_cat: code,
    respond: llm,
  }

  escalation: {
    respond: frontier_llm,
    on_error: fallback_to_frontier_llm,
    on_quality_drop: require_human_review,
    on_timeout: escalate_to_human,
  }
}
