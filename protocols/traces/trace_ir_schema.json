{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenWorkCompiler Trace IR Schema",
  "type": "object",
  "required": [
    "run_id",
    "source_agent",
    "steps",
    "result"
  ],
  "properties": {
    "run_id": {
      "type": "string"
    },
    "source_agent": {
      "type": "string",
      "description": "Agent framework origin (openai, langgraph, braintrust, openworker, custom)"
    },
    "start_time": {
      "type": "string",
      "format": "date-time"
    },
    "end_time": {
      "type": "string",
      "format": "date-time"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "actor",
          "action",
          "timestamp"
        ],
        "properties": {
          "step_id": {
            "type": "string"
          },
          "actor": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "input": {
            "type": "object"
          },
          "output": {
            "type": "object"
          },
          "timestamp": {
            "type": "string"
          },
          "latency_ms": {
            "type": "number"
          },
          "token_usage": {
            "type": "object"
          }
        }
      }
    },
    "result": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "success",
            "failure",
            "cancelled"
          ]
        },
        "summary": {
          "type": "string"
        },
        "error": {
          "type": "string"
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "agent_version": {
          "type": "string"
        },
        "model_name": {
          "type": "string"
        },
        "environment": {
          "type": "string"
        }
      }
    }
  }
}