# HOW — OpenWorkLang source generated by the OpenWorkflow build emitter from session 01a04b1c-99ae-7733-8b77-814966c86046.
# WHAT lives in the task/behavior contracts; this file decides how each action executes and where
# an agent must stay in the loop. Edit and recompile:  python3 -m core.openworklang compile /Users/hongmartin/orca/projects/open-workflow/build/codex_session/codex_session.work
#
# executors: code = replay deterministic handler (0 tokens) · rule = RuleExecutor · ml/slm = trained model once
#            promoted (fallback: llm) · llm = frontier model (prompts/<action>.prompt.md) · human = review gate
# escalation: agent = the step's output was synthesized by the agent; must be regenerated when params change


work codex_session {
  goal: "Compiled workflow for automating codex session"

  params:
    - none

  inputs:
    - content
    - raw_args
    - cmd

  outputs:
    - content
    - tool_calls
    - role
    - response_id
    - status

  invariants:
    - use_current_pricing_policy
    - verify_current_contract

  workflow:
    - shell_python3
    - shell_find
    - respond

  executors: {
    shell_python3: code,
    shell_find: code,
    respond: llm,
  }

  escalation: {
    respond: frontier_llm,
    on_error: fallback_to_frontier_llm,
    on_quality_drop: require_human_review,
    on_timeout: escalate_to_human,
  }
}
