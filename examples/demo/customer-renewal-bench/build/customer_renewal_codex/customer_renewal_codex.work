# HOW — OpenWorkLang source generated by the OpenWorkflow build emitter from session 01a04b0b-3a8a-72b2-8905-cb600a9ad15a.
# WHAT lives in the task/behavior contracts; this file decides how each action executes and where
# an agent must stay in the loop. Edit and recompile:  python3 -m core.openworklang compile build/customer_renewal_codex/customer_renewal_codex.work
#
# executors: code = replay deterministic handler (0 tokens) · rule = RuleExecutor · ml/slm = trained model once
#            promoted (fallback: llm) · llm = frontier model (prompts/<action>.prompt.md) · human = review gate
# escalation: agent = the step's output was synthesized by the agent; must be regenerated when params change
#   write_pricing_cust_1001: content synthesized by the agent (e.g. 1080.0, 40.00, 10,800.00, 129,600.00) — a front agent regenerates it for new params via prompts/write_pricing_cust_1001.prompt.md
#   customer_id: recorded value CUST-1001; bound from the request at run time (see PARAMS.json)

work customer_renewal_codex {
  goal: "Compiled workflow for automating customer renewal codex"

  params:
    - customer_id

  inputs:
    - content
    - raw_args
    - cmd

  outputs:
    - content
    - tool_calls
    - role
    - response_id
    - status

  invariants:
    - use_current_pricing_policy
    - verify_current_contract

  workflow:
    - shell_sed
    - shell_rg
    - shell_cat
    - shell_jq
    - shell_mkdir
    - write_pricing_cust_1001
    - respond

  executors: {
    shell_sed: code,
    shell_rg: code,
    shell_cat: code,
    shell_jq: code,
    shell_mkdir: code,
    write_pricing_cust_1001: code,
    respond: slm,
  }

  escalation: {
    write_pricing_cust_1001: agent,
    respond: frontier_llm,
    on_error: fallback_to_frontier_llm,
    on_quality_drop: require_human_review,
    on_timeout: escalate_to_human,
  }
}
