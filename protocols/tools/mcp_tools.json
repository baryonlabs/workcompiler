{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenWorkflow MCP Tool Protocol Endpoint Specification",
  "type": "object",
  "required": [
    "protocol_version",
    "tools"
  ],
  "properties": {
    "protocol_version": {
      "type": "string",
      "const": "2026-03"
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "description",
          "inputSchema"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "inputSchema": {
            "type": "object"
          }
        }
      }
    }
  }
}