#
# executors: code = replay deterministic handler (0 tokens) · rule = RuleExecutor · ml/slm = trained model once
#            promoted (fallback: llm) · llm = frontier model (prompts/<action>.prompt.md) · human = review gate
# escalation: agent = the step's output was synthesized by the agent; must be regenerated when params change
#   customer_id: recorded value CUST-1001; bound from the request at run time (see PARAMS.json)
#   contract_id: recorded value CTR-2024-0917; bound from the request at run time (see PARAMS.json)

work customer_renewal_claude {
  goal: "Compiled workflow for automating customer renewal claude"

  params:
    - customer_id
    - contract_id

  inputs:
    - content
    - file_path
    - cmd

  outputs:
    - content
    - tool_calls
    - role
    - response_id
    - status
    - stop_reason
    - cache_creation_tokens

  invariants:
    - keep_report_evidence_auditable
    - require_quality_engineer_approval
    - gate_causation_by_calibration
    - use_authoritative_thresholds
    - bound_cause_to_trusted_evidence
    - verify_bound_mes_anomaly
    - keep_decision_artifacts_auditable
    - apply_refund_eligibility_rules
    - enforce_finance_approval_threshold
    - verify_receipt_before_decision
    - prove_duplicate_from_successful_payments
    - use_authoritative_policy_v3
    - verify_successful_payment_receipt
    - escalate_unresolved_source_conflicts
    - correlate_changes_without_causation
    - classify_signature_exactly
    - use_runbook_faithfully
    - escalate_without_remediation
    - select_exact_current_alert
    - meet_triage_sla_and_output_contract
    - enforce_discount_approval_cap
    - verify_active_contract
    - include_required_clauses_verbatim
    - use_current_pricing_policy
    - verify_current_contract

  workflow:
    - read_task
    - read_contracts
    - read_behavior
    - shell_cd
    - shell_mkdir
    - shell_cat
    - respond

  executors: {
    read_task: code,
    read_contracts: code,
    read_behavior: code,
    shell_cd: code,
    shell_mkdir: code,
    shell_cat: code,
    respond: llm,
  }

  escalation: {
    respond: frontier_llm,
    on_error: fallback_to_frontier_llm,
    on_quality_drop: require_human_review,
    on_timeout: escalate_to_human,
  }
}
